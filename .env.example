APP_NAME="Staff Portal Sample"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=staff_portal
# DB_USERNAME=root
# DB_PASSWORD=

QUEUE_CONNECTION=database

CACHE_STORE=database

SESSION_DRIVER=database

OTP_TTL=600
OTP_DIGITS=6
OTP_MAX_ATTEMPTS=5
OTP_SEND_RATE_LIMIT_PER_MINUTE=3
OTP_VERIFY_RATE_LIMIT_PER_MINUTE=5

# SMS driver: 'log' writes outbound messages to the application log.
# Add a new driver value and a matching case in AppServiceProvider
# when integrating a real SMS carrier.
OTP_SMS_DRIVER=log

DOCUMENT_MAX_SIZE_BYTES=10485760
