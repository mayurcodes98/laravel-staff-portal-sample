APP_NAME="Staff Portal Sample"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=staff_portal
# DB_USERNAME=root
# DB_PASSWORD=

QUEUE_CONNECTION=database

CACHE_STORE=database

SESSION_DRIVER=database

OTP_TTL=600
OTP_DIGITS=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MINUTE=3

DOCUMENT_MAX_SIZE_BYTES=10485760

# SMS Gateway
# Set SMS_DRIVER=log for development (default).
# Replace LogSmsGateway binding in AppServiceProvider for production.
SMS_DRIVER=log
